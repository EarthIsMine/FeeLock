# Keep this file at the repo root as .env and link it for Foundry, which only reads contracts/.env:
#   cp .env.example .env && ln -s ../.env contracts/.env

# RPC endpoints. Public endpoints work without a key.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Optional backups (e.g. Alchemy). The SDK tries them after the primary fails; Foundry uses only the primary.
MONAD_MAINNET_RPC_URL_FALLBACK=
MONAD_TESTNET_RPC_URL_FALLBACK=

# Deployer / demo executor key. Never commit a real value.
FEELOCK_PK=

# Web app (apps/web). Only VITE_* variables reach the browser bundle, where anyone can read them:
# never put a private key or a paid provider URL without a domain allowlist here.
VITE_CHAIN_ID=10143
# Optional; defaults to the chain's public RPC.
VITE_MONAD_TESTNET_RPC_URL=
