# RPC endpoints. Public endpoints work without a key; swap in a provider URL
# (e.g. https://monad-mainnet.g.alchemy.com/v2/<key>) if you hit rate limits.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer / demo executor key. Never commit a real value.
FEELOCK_PK=
